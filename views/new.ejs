<%- include("partials/header", { title: "New Post · The Daily Planet" }) %>

<section class="form-section">
  <a href="/" class="back-link">&larr; Back to all posts</a>
  <h1>Write a New Post</h1>

  <form action="/posts" method="POST" class="post-form">
    <label for="title">Title</label>
    <input type="text" id="title" name="title" placeholder="Headline for your story" required />

    <label for="author">Author</label>
    <input type="text" id="author" name="author" placeholder="Your name (optional)" />

    <label for="imageUrl">Image URL</label>
    <input type="url" id="imageUrl" name="imageUrl" placeholder="https://example.com/image.jpg (optional)" />

    <label for="content">Content</label>
    <textarea id="content" name="content" rows="10" placeholder="Write your story here..." required></textarea>

    <div class="form-actions">
      <button type="submit" class="btn btn-accent">Publish Post</button>
      <a href="/" class="btn">Cancel</a>
    </div>
  </form>
</section>

<%- include("partials/footer") %>
